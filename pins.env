# Everything the build downloads, except Node itself (see NODE_VERSION), is pinned here.
# Shell syntax: sourced by the scripts and by CI. One KEY=value per line, no quoting.

# ops CLI, from https://storage.googleapis.com/cli/<os>[/aarch64]/release/<version>/ops.
# Upstream publishes only an md5 next to each binary. These sha256 values were computed when
# the version was pinned, after checking that upstream md5.
OPS_VERSION=0.1.47
OPS_SHA256_LINUX_X64=c17196d9656b72b86d125a661ca2ddebe84f5f63f6393229da472362a6587196
OPS_SHA256_LINUX_ARM64=c2ba8d039774a27b7ca7de6e1a64f6dada673d6c0057a2b4e7c37e49e3a7c362
OPS_SHA256_DARWIN_ARM64=b1f2cfcd4857e25f26717b4d5b020cab44971e2a11b35424bd476e803da40819

# Nanos kernel release, from https://storage.googleapis.com/nanos/release/<version>/.
# x64 is nanos-release-linux-<v>.tar.gz; arm64 is nanos-release-linux-<v>-virt.tar.gz.
# ops itself does not checksum kernel downloads, so the build installs them from these pins.
NANOS_VERSION=0.1.56
NANOS_SHA256_X64=481e10d4111192faa89ea9f7aa32020977562ae5a9b1057c2aa667ec67af81a5
NANOS_SHA256_ARM64=740f231c0b9fcc7917d22e57d890bf71d50003710d0519df8ae0e967b04f3e96

# Node.js release signing keys: gpg-only-active-keys/pubring.kbx from github.com/nodejs/release-keys.
NODE_RELEASE_KEYS_COMMIT=481637f813e912c4aa3622d7964ab426c97b8e8d
NODE_RELEASE_KEYRING_SHA256=140f2ad5260fd62773b6243ce8e1d3009645d558f121b8262c55e383dc285932

# debian:trixie-slim. The package's glibc/libstdc++/libgcc_s come from the per-architecture images.
# The tools container is built from the multi-arch index, so it always runs natively, and its
# apt sources point at the snapshot.debian.org timestamp the image was built from.
DEBIAN_INDEX_DIGEST=sha256:62bd423aeee912639ca8ee681c2b762cb3e25137e0a92b20be455898a9f034ad
DEBIAN_DIGEST_X64=sha256:4876fdea29cac1a33a3195f1eb1952feb1fca7dd6dd00be3e2f1879cf20d34d2
DEBIAN_DIGEST_ARM64=sha256:a66b19aa552f595b4ab276c6b4f9b24fa4546632c5ecd88cccdced4a6866323a
DEBIAN_SNAPSHOT=20261020T213255Z

# ubuntu:24.04 (multi-arch index) for the test container, matching GitHub's ubuntu-24.04 runners.
# QEMU and the other test tools come from this snapshot.ubuntu.com timestamp.
UBUNTU_INDEX_DIGEST=sha256:68ee22004a9109b44973313b02ff7b1de250f1de0f5ecb628d73f579aaff33ac
UBUNTU_SNAPSHOT=20261020T000000Z
